ng_top":36,"padding_bottom":36}},"image_with_text_4EqaQ8":{"type":"image-with-text","blocks":{"text_FeMB9q":{"type":"text","settings":{"text":"<ul><li>QBP provides regular employee education and provides regular employee education and training on DEI topics. We’ve also signed the CEO Outdoor Diversity Pledge and the Radical Adventure Riders’ <a href=\"https:\/\/radicaladventureriders.com\/cip\" target=\"_blank\">Cycling Industry Pledge<\/a> as part of our commitment to a better, more-diverse bike world.<\/li><li>Community support – To support our communities, we’re contributing to efforts such as the Bikepacking Roots BIPOC Adventure Grant and and <a href=\"https:\/\/radicaladventureriders.com\/\" target=\"_blank\" title=\"https:\/\/radicaladventureriders.com\/\">Radical Adventure Riders<\/a> mission to support gender inclusivity and racial equity in cycling and the outdoors, as well as providing our employees with more paid volunteer time so they can participate on the local level.<\/li><li>Ongoing initiatives – Internally, we’re addressing any problematic vocabulary used in our brand materials, diversifying our roster of sponsored riders and creative partners, and focusing on telling more inclusive stories.<\/li><\/ul>","text_style":"body"}}},"block_order":["text_FeMB9q"],"settings":{"image":"shopify:\/\/shop_images\/About_Inclusion_2of2.jpg","height":"adapt","desktop_image_width":"medium","layout":"image_first","desktop_content_position":"top","desktop_content_alignment":"left","content_layout":"no-overlap","section_color_scheme":"","color_scheme":"","image_behavior":"none","mobile_content_alignment":"left","padding_top":36,"padding_bottom":36}}},"order":["image_banner_GMRqmf","main","rich_text_X4MBBB","collage_jCQRFx","multicolumn_GtihV3","image_with_text_GeeCC9","image_with_text_4EqaQ8"]}