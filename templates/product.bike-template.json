        "text_PpmjL8": {
          "type": "text",
          "settings": {
            "text": "<p>The All-City Cosmic Stallion GRX is thoroughly modern and classically styled – all on a lightweight disc-brake frameset. With the latest development of fork-mounted cargo solutions, the Cosmic Stallion GRX brings uncluttered potential to gravel riders and beyond. From fast sprints to all-day epics, this race-ready steel machine sets a new standard for beauty and functionality.</p>"
          }
        }
