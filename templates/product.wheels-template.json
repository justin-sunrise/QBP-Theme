        "custom_liquid_96Qzxh": {
          "type": "custom_liquid",
          "name": "Free Shipping Indicator",
          "settings": {
            "custom_liquid": "{%- liquid\n  assign threshold = 75\n  assign comparison = 'gte'\n  assign qualify_text = '✓ This item ships free'\n  assign show_progress = true\n  assign progress_text = 'Add [amount] more for free shipping'\n  assign qualify_color = '#fff'\n  assign background_color = '#1A7F37'\n  assign progress_color = '#444444'\n  assign progress_background_color = '#e0e0e0'\n  assign font_size = 14\n  assign font_weight = 600\n  assign alignment = 'left'\n  assign margin_top = 8\n  assign margin_bottom = 8\n-%}\n\n{%- if product -%}\n  {%- liquid\n    assign uid = product.id\n    assign threshold_cents = threshold | times: 100 | round\n    assign current_variant = product.selected_or_first_available_variant\n    assign current_price = current_variant.price\n\n    assign current_qualifies = false\n    if comparison == 'gt'\n      if current_price > threshold_cents\n        assign current_qualifies = true\n      endif\n    else\n      if current_price >= threshold_cents\n        assign current_qualifies = true\n      endif\n    endif\n  -%}\n\n  <style>\n    .ai-free-ship-{{ uid }} {\n      display: block;\n      text-align: {{ alignment }};\n      margin-top: {{ margin_top }}px;\n      margin-bottom: {{ margin_bottom }}px;\n      padding: 4px 12px;\n      border-radius: 16px;\n      width: fit-content;\n    }\n    .ai-free-ship__message-{{ uid }} {\n      display: inline-block;\n      font-size: {{ font_size }}px;\n   \n      font-weight: {{ font_weight }};\n      line-height: 1.4;\n      margin: 0;\n    }\n  .ai-free-ship__message-{{ uid }}[data-state=\"qualifies\"] { color: {{ qualify_color }}; }\n    .ai-free-ship__message-{{ uid }}[data-state=\"progress\"] { color: {{ progress_color }}; }\n    .ai-free-ship-{{ uid }}[data-state=\"qualifies\"] { background-color: {{ background_color }}; }\n    .ai-free-ship-{{ uid }}[data-state=\"progress\"] { background-color: {{ progress_background_color }}; }\n  </style>\n\n  <free-shipping-{{ uid }}\n    class=\"ai-free-ship-{{ uid }}\"\n    data-current-variant=\"{{ current_variant.id }}\"\n    data-state=\"{% if current_qualifies %}qualifies{% else %}progress{% endif %}\"\n  >\n    {%- if current_qualifies -%}\n      <p class=\"ai-free-ship__message-{{ uid }}\" data-message data-state=\"qualifies\">\n        {{ qualify_text }}\n      </p>\n    {%- else -%}\n      {%- if show_progress -%}\n        {%- assign remaining_cents = threshold_cents | minus: current_price -%}\n        {%- if comparison == 'gt' -%}\n          {%- assign remaining_cents = remaining_cents | plus: 1 -%}\n        {%- endif -%}\n        {%- assign remaining_money = remaining_cents | money -%}\n        <p class=\"ai-free-ship__message-{{ uid }}\" data-message data-state=\"progress\">\n          {{ progress_text | replace: '[amount]', remaining_money }}\n        </p>\n      {%- else -%}\n        <p class=\"ai-free-ship__message-{{ uid }}\" data-message data-state=\"progress\" style=\"display:none;\"></p>\n      {%- endif -%}\n    {%- endif -%}\n\n    <script type=\"application/json\" data-variant-shipping>\n      {\n        {%- for v in product.variants -%}\n          {%- liquid\n            assign v_qualifies = false\n            if comparison == 'gt'\n              if v.price > threshold_cents\n                assign v_qualifies = true\n              endif\n            else\n              if v.price >= threshold_cents\n                assign v_qualifies = true\n              endif\n            endif\n            assign v_remaining_cents = threshold_cents | minus: v.price\n            if comparison == 'gt'\n              assign v_remaining_cents = v_remaining_cents | plus: 1\n            endif\n            assign v_remaining_money = v_remaining_cents | money\n          -%}\n          \"{{ v.id }}\": {\n            \"qualifies\": {% if v_qualifies %}true{% else %}false{% endif %},\n            \"remaining\": {{ v_remaining_money | json }}\n          }{%- unless forloop.last -%},{%- endunless -%}\n        {%- endfor -%}\n      }\n    </script>\n  </free-shipping-{{ uid }}>\n\n  <script>\n    (function() {\n      if (customElements.get('free-shipping-{{ uid }}')) { return; }\n\n      class FreeShipping{{ uid }} extends HTMLElement {\n        connectedCallback() {\n          this.message = this.querySelector('[data-message]');\n          this.showProgress = {% if show_progress %}true{% else %}false{% endif %};\n          this.progressTemplate = {{ progress_text | json }};\n          this.qualifyText = {{ qualify_text | json }};\n\n          var dataEl = this.querySelector('[data-variant-shipping]');\n          try {\n            this.data = dataEl ? JSON.parse(dataEl.textContent) : {};\n          } catch (e) {\n            this.data = {};\n          }\n\n          this.onChange = this.onChange.bind(this);\n          document.addEventListener('change', this.onChange, true);\n          document.addEventListener('variant:update', this.onChange);\n          document.addEventListener('on:variant:change', this.onChange);\n        }\n\n        disconnectedCallback() {\n          document.removeEventListener('change', this.onChange, true);\n          document.removeEventListener('variant:update', this.onChange);\n          document.removeEventListener('on:variant:change', this.onChange);\n        }\n\n        currentVariantId() {\n          var input = document.querySelector('form[action*=\"/cart/add\"] [name=\"id\"]');\n          if (input && input.value) { return input.value; }\n          return this.dataset.currentVariant;\n        }\n\n        onChange() {\n          var self = this;\n          window.setTimeout(function() { self.render(self.currentVariantId()); }, 0);\n        }\n\n        render(variantId) {\n          if (!this.message) { return; }\n          var info = this.data[variantId];\n          if (!info) { return; }\n          if (info.qualifies) {\n            this.setAttribute('data-state', 'qualifies');\n            this.message.setAttribute('data-state', 'qualifies');\n            this.message.textContent = this.qualifyText;\n            this.message.style.display = '';\n          } else if (this.showProgress) {\n            this.setAttribute('data-state', 'progress');\n            this.message.setAttribute('data-state', 'progress');\n            this.message.textContent = this.progressTemplate.replace('[amount]', info.remaining);\n            this.message.style.display = '';\n          } else {\n            this.setAttribute('data-state', 'progress');\n            this.message.style.display = 'none';\n            this.message.textContent = '';\n          }\n        }\n      }\n\n      customElements.define('free-shipping-{{ uid }}', FreeShipping{{ uid }});\n    })();\n  </script>\n{%- endif -%}"
          }
