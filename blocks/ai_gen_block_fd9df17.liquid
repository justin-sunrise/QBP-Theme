{% doc %}
  @prompt
    A pop-up modal that features a size chart. The button for the modal will be styled like a button used in a rich text content block. 
    The size chart will include the variant-level details: rider height, inner leg length, saddle hight (pedal to top), and saddle height (BB to top). The values in the size chart should be dynamic, linked to variant metafields. 
    Include a rich content field above the table in the modal for a description of the size chart. Include another rich content field below the table in the model for Additional Notes., For the table values under Saddle Height (Pedal to Top) use the variant metafield "custom.saddle_height_pedal_to_top". For the table values under Saddle Height (BB to Top" use the metafield "custom.saddle_height_bb_to_top". , Provide more styling options for the button, such as size, alignment and color scheme options., Can the button use the sinter font?
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-size-chart-button-wrapper-{{ ai_gen_id }} {
    text-align: {{ block.settings.button_alignment }};
    margin: {{ block.settings.button_margin_top }}px 0 {{ block.settings.button_margin_bottom }}px;
  }

  .ai-size-chart-button-{{ ai_gen_id }} {
    display: inline-block;
    padding: {{ block.settings.button_padding_vertical }}px {{ block.settings.button_padding_horizontal }}px;
    background-color: {{ block.settings.button_bg_color }};
    color: {{ block.settings.button_text_color }};
    border: {{ block.settings.button_border_thickness }}px solid {{ block.settings.button_border_color }};
    border-radius: {{ block.settings.button_border_radius }}px;
    cursor: pointer;
    font-size: {{ block.settings.button_font_size }}px;
    font-weight: {{ block.settings.button_font_weight }};
    font-family: {{ block.settings.button_font.family }}, {{ block.settings.button_font.fallback_families }};
    font-style: {{ block.settings.button_font.style }};
    text-decoration: none;
    transition: all 0.3s ease;
    line-height: 1.4;
  }

  .ai-size-chart-button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_bg }};
    color: {{ block.settings.button_hover_text_color }};
    border-color: {{ block.settings.button_hover_border_color }};
  }

  .ai-size-chart-modal-{{ ai_gen_id }} {
    display: none;
    position: fixed;
    z-index: 9999;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    overflow: auto;
    background-color: rgba(0, 0, 0, 0.5);
  }

  .ai-size-chart-modal-{{ ai_gen_id }}.active {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-size-chart-modal-content-{{ ai_gen_id }} {
    background-color: {{ block.settings.modal_bg_color }};
    padding: 40px;
    border: {{ block.settings.modal_border_thickness }}px solid {{ block.settings.modal_border_color }};
    border-radius: {{ block.settings.modal_border_radius }}px;
    width: 90%;
    max-width: {{ block.settings.modal_max_width }}px;
    max-height: 90vh;
    overflow-y: auto;
    position: relative;
  }

  .ai-size-chart-close-{{ ai_gen_id }} {
    position: absolute;
    top: 15px;
    right: 15px;
    background: none;
    border: none;
    font-size: 28px;
    cursor: pointer;
    color: {{ block.settings.text_color }};
    padding: 5px 10px;
    line-height: 1;
  }

  .ai-size-chart-close-{{ ai_gen_id }}:hover {
    opacity: 0.7;
  }

  .ai-size-chart-title-{{ ai_gen_id }} {
    margin: 0 0 20px;
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.title_size }}px;
  }

  .ai-size-chart-description-{{ ai_gen_id }} {
    margin-bottom: 24px;
    color: {{ block.settings.text_color }};
  }

  .ai-size-chart-table-wrapper-{{ ai_gen_id }} {
    overflow-x: auto;
    margin-bottom: 24px;
  }

  .ai-size-chart-table-{{ ai_gen_id }} {
    width: 100%;
    border-collapse: collapse;
    border: 1px solid {{ block.settings.table_border_color }};
  }

  .ai-size-chart-table-{{ ai_gen_id }} th,
  .ai-size-chart-table-{{ ai_gen_id }} td {
    padding: 12px;
    text-align: left;
    border: 1px solid {{ block.settings.table_border_color }};
    color: {{ block.settings.text_color }};
  }

  .ai-size-chart-table-{{ ai_gen_id }} th {
    background-color: {{ block.settings.table_header_bg }};
    font-weight: 600;
  }

  .ai-size-chart-table-{{ ai_gen_id }} td {
    background-color: {{ block.settings.table_cell_bg }};
  }

  .ai-size-chart-notes-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
  }

  .ai-size-chart-empty-{{ ai_gen_id }} {
    text-align: center;
    padding: 20px;
    color: #999;
    font-style: italic;
  }

  @media screen and (max-width: 749px) {
    .ai-size-chart-modal-content-{{ ai_gen_id }} {
      padding: 24px;
      width: 95%;
    }

    .ai-size-chart-table-{{ ai_gen_id }} th,
    .ai-size-chart-table-{{ ai_gen_id }} td {
      padding: 8px;
      font-size: 14px;
    }

    .ai-size-chart-button-{{ ai_gen_id }} {
      font-size: {{ block.settings.button_font_size | times: 0.9 }}px;
      padding: {{ block.settings.button_padding_vertical | times: 0.8 }}px {{ block.settings.button_padding_horizontal | times: 0.8 }}px;
    }
  }
{% endstyle %}

<size-chart-modal-{{ ai_gen_id }} {{ block.shopify_attributes }}>
  <div class="ai-size-chart-button-wrapper-{{ ai_gen_id }}">
    <button
      class="ai-size-chart-button-{{ ai_gen_id }}"
      aria-label="Open size chart"
    >
      {{ block.settings.button_text }}
    </button>
  </div>

  <div
    class="ai-size-chart-modal-{{ ai_gen_id }}"
    role="dialog"
    aria-modal="true"
    aria-labelledby="size-chart-title-{{ ai_gen_id }}"
  >
    <div class="ai-size-chart-modal-content-{{ ai_gen_id }}">
      <button
        class="ai-size-chart-close-{{ ai_gen_id }}"
        aria-label="Close size chart"
      >
        &times;
      </button>

      <h2
        id="size-chart-title-{{ ai_gen_id }}"
        class="ai-size-chart-title-{{ ai_gen_id }}"
      >
        {{ block.settings.modal_title }}
      </h2>

      {% if block.settings.description != blank %}
        <div class="ai-size-chart-description-{{ ai_gen_id }}">
          {{ block.settings.description }}
        </div>
      {% endif %}

      <div class="ai-size-chart-table-wrapper-{{ ai_gen_id }}">
        {% if product.variants.size > 0 %}
          <table class="ai-size-chart-table-{{ ai_gen_id }}">
            <thead>
              <tr>
                <th>{{ block.settings.column_size_label }}</th>
                <th>{{ block.settings.column_rider_height_label }}</th>
                <th>{{ block.settings.column_inner_leg_label }}</th>
                <th>{{ block.settings.column_saddle_pedal_label }}</th>
                <th>{{ block.settings.column_saddle_bb_label }}</th>
              </tr>
            </thead>
            <tbody>
              {% for variant in product.variants %}
                <tr>
                  <td>{{ variant.title }}</td>
                  <td>
                    {% if variant.metafields.custom.rider_height != blank %}
                      {{ variant.metafields.custom.rider_height }}
                    {% else %}
                      -
                    {% endif %}
                  </td>
                  <td>
                    {% if variant.metafields.custom.inner_leg_length != blank %}
                      {{ variant.metafields.custom.inner_leg_length }}
                    {% else %}
                      -
                    {% endif %}
                  </td>
                  <td>
                    {% if variant.metafields.custom.saddle_height_pedal_to_top != blank %}
                      {{ variant.metafields.custom.saddle_height_pedal_to_top }}
                    {% else %}
                      -
                    {% endif %}
                  </td>
                  <td>
                    {% if variant.metafields.custom.saddle_height_bb_to_top != blank %}
                      {{ variant.metafields.custom.saddle_height_bb_to_top }}
                    {% else %}
                      -
                    {% endif %}
                  </td>
                </tr>
              {% endfor %}
            </tbody>
          </table>
        {% else %}
          <div class="ai-size-chart-empty-{{ ai_gen_id }}">
            No variants available for this product
          </div>
        {% endif %}
      </div>

      {% if block.settings.additional_notes != blank %}
        <div class="ai-size-chart-notes-{{ ai_gen_id }}">
          {{ block.settings.additional_notes }}
        </div>
      {% endif %}
    </div>
  </div>
</size-chart-modal-{{ ai_gen_id }}>

<script>
  (function() {
    class SizeChartModal{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.button = this.querySelector('.ai-size-chart-button-{{ ai_gen_id }}');
        this.modal = this.querySelector('.ai-size-chart-modal-{{ ai_gen_id }}');
        this.closeButton = this.querySelector('.ai-size-chart-close-{{ ai_gen_id }}');
        
        this.setupEventListeners();
      }

      setupEventListeners() {
        this.button.addEventListener('click', () => {
          this.openModal();
        });

        this.closeButton.addEventListener('click', () => {
          this.closeModal();
        });

        this.modal.addEventListener('click', (event) => {
          if (event.target === this.modal) {
            this.closeModal();
          }
        });

        document.addEventListener('keydown', (event) => {
          if (event.key === 'Escape' && this.modal.classList.contains('active')) {
            this.closeModal();
          }
        });
      }

      openModal() {
        this.modal.classList.add('active');
        document.body.style.overflow = 'hidden';
        this.closeButton.focus();
      }

      closeModal() {
        this.modal.classList.remove('active');
        document.body.style.overflow = '';
        this.button.focus();
      }
    }

    customElements.define('size-chart-modal-{{ ai_gen_id }}', SizeChartModal{{ ai_gen_id }});
  })();
</script>

