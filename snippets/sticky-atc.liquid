<sticky-atc-bar class="sticky-atc gradient color-{{ section.settings.color_scheme }}" data-section="{{ section.id }}">
  <div class="page-width sticky-atc__inner">
    {%- assign sticky_media = product.selected_or_first_available_variant.featured_media
      | default: product.featured_media
    -%}
    {%- if sticky_media -%}
      <img
        class="sticky-atc__image"
        src="{{ sticky_media.preview_image | image_url: width: 120 }}"
        alt="{{ sticky_media.alt | escape }}"
        width="60"
        height="{{ 60 | divided_by: sticky_media.preview_image.aspect_ratio | round }}"
        loading="lazy"
      >
    {%- endif -%}
    <div class="sticky-atc__details">
      <span class="sticky-atc__title">{{ product.title | escape }}</span>
      <span class="sticky-atc__price">
        {{- product.selected_or_first_available_variant.price | money -}}
      </span>
    </div>
    <button type="button" class="button button--full-width sticky-atc__button">
      <span>
        {%- if product.selected_or_first_available_variant.available -%}
          {{ 'products.product.add_to_cart' | t }}
        {%- else -%}
          {{ 'products.product.sold_out' | t }}
        {%- endif -%}
      </span>
    </button>
  </div>
</sticky-atc-bar>

<style>
  .sticky-atc {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 4;
    transform: translateY(110%);
    transition: transform 0.25s ease;
    border-top: 0.1rem solid rgba(var(--color-foreground), 0.08);
    box-shadow: 0 -0.2rem 1rem rgba(var(--color-shadow), 0.1);
    padding-top: 1rem;
    padding-bottom: calc(1rem + env(safe-area-inset-bottom, 0px));
  }

  .sticky-atc--visible {
    transform: translateY(0);
  }

  .sticky-atc__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
  }

  .sticky-atc__image {
    width: 4.5rem;
    height: 4.5rem;
    object-fit: cover;
    border-radius: var(--media-radius, 0);
    flex-shrink: 0;
  }

  .sticky-atc__details {
    display: flex;
    flex-direction: column;
    min-width: 0;
    flex: 1;
  }

  .sticky-atc__title {
    font-family: var(--font-heading-family);
    font-style: var(--font-heading-style);
    font-weight: var(--font-heading-weight);
    font-size: 1.4rem;
    line-height: 1.3;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .sticky-atc__price {
    font-size: 1.4rem;
    font-weight: 600;
  }

  .sticky-atc__button {
    width: auto;
    min-width: 15rem;
    flex-shrink: 0;
  }

  @media screen and (min-width: 750px) {
    .sticky-atc__title,
    .sticky-atc__price {
      font-size: 1.6rem;
    }

    .sticky-atc__button {
      min-width: 22rem;
    }

    .sticky-atc__image {
      width: 5.5rem;
      height: 5.5rem;
    }
  }
</style>

<script>
  if (!customElements.get('sticky-atc-bar')) {
    customElements.define(
      'sticky-atc-bar',
      class StickyAtcBar extends HTMLElement {
        connectedCallback() {
          this.sectionId = this.dataset.section;
          this.mainButton = document.getElementById(`ProductSubmitButton-${this.sectionId}`);
          this.mainPrice = document.getElementById(`price-${this.sectionId}`);
          this.button = this.querySelector('.sticky-atc__button');
          this.buttonLabel = this.button.querySelector('span');
          this.priceEl = this.querySelector('.sticky-atc__price');
          this.imageEl = this.querySelector('.sticky-atc__image');

          if (!this.mainButton) return;

          if (this.imageEl && typeof subscribe === 'function' && window.PUB_SUB_EVENTS?.variantChange) {
            this.unsubscribeVariantChange = subscribe(PUB_SUB_EVENTS.variantChange, (event) => {
              const media = event.data?.variant?.featured_media?.preview_image;
              if (!media?.src) return;
              const separator = media.src.includes('?') ? '&' : '?';
              this.imageEl.src = `${media.src}${separator}width=120`;
            });
          }

          this.button.addEventListener('click', () => {
            this.mainButton.click();
          });

          this.intersectionObserver = new IntersectionObserver(
            ([entry]) => {
              const scrolledPast = !entry.isIntersecting && entry.boundingClientRect.top < 0;
              this.classList.toggle('sticky-atc--visible', scrolledPast);
            },
            { threshold: 0 }
          );
          this.intersectionObserver.observe(this.mainButton);

          this.mutationObserver = new MutationObserver(() => this.syncState());
          this.mutationObserver.observe(this.mainButton, {
            attributes: true,
            childList: true,
            subtree: true,
          });
          if (this.mainPrice) {
            this.mutationObserver.observe(this.mainPrice, { childList: true, subtree: true });
          }

          this.syncState();
        }

        disconnectedCallback() {
          this.intersectionObserver?.disconnect();
          this.mutationObserver?.disconnect();
          this.unsubscribeVariantChange?.();
        }

        syncState() {
          this.button.disabled = this.mainButton.hasAttribute('disabled');

          const mainLabel = this.mainButton.querySelector('span:not(.sold-out-message)');
          const soldOutMessage = this.mainButton.querySelector('.sold-out-message');
          if (soldOutMessage && !soldOutMessage.classList.contains('hidden')) {
            this.buttonLabel.textContent = soldOutMessage.textContent.trim();
          } else if (mainLabel) {
            this.buttonLabel.textContent = mainLabel.textContent.trim();
          }

          if (!this.mainPrice) return;
          const onSale = this.mainPrice.querySelector('.price--on-sale');
          const priceItem = onSale
            ? this.mainPrice.querySelector('.price__sale .price-item--sale')
            : this.mainPrice.querySelector('.price__regular .price-item--regular');
          if (priceItem) {
            this.priceEl.textContent = priceItem.textContent.trim();
          }
        }
      }
    );
  }
</script>
